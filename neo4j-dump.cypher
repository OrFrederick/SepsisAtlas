UNWIND [{canonical:\"pleura_infection\", properties:{category:\"other\"}}, {canonical:\"bloodstream_infection\", properties:{category:\"other\"}}, {canonical:\"catheter_infection\", properties:{category:\"other\"}}, {canonical:\"cns_infection\", properties:{category:\"other\"}}, {canonical:\"unknown_infection_site\", properties:{category:\"other\"}}, {canonical:\"culture_results\", properties:{category:\"other\"}}, {canonical:\"enterococcus\", properties:{category:\"other\"}}, {canonical:\"klebsiella\", properties:{category:\"other\"}}, {canonical:\"candida\", properties:{category:\"other\"}}, {canonical:\"aspergillus\", properties:{category:\"other\"}}, {canonical:\"antibiotics_pre_icu\", properties:{category:\"other\"}}, {canonical:\"nutritional_therapy\", properties:{category:\"other\"}}, {canonical:\"nutrition_prescription\", properties:{category:\"other\"}}, {canonical:\"icu_mortality_rate\", properties:{category:\"other\"}}, {canonical:\"in_hospital_mortality_rate\", properties:{category:\"other\"}}, {canonical:\"culture_result\", properties:{category:\"other\"}}, {canonical:\"fluid_resuscitation_3h\", properties:{category:\"other\"}}, {canonical:\"fluid_resuscitation_6h\", properties:{category:\"other\"}}, {canonical:\"fluid_resuscitation_24h\", properties:{category:\"other\"}}, {canonical:\"wound_infection\", properties:{category:\"other\"}}] AS row
