# Sepsis Atlas — atlas.efferon.com
#
# This Caddyfile is baked into the frontend container image at
# /etc/caddy/Caddyfile. Caddy terminates TLS on :80/:443 and reverse-
# proxies every request that isn't a FastAPI route to the Next.js server
# running alongside it on localhost:3000 (see docker/Dockerfile.frontend).
# API routes go to the `backend` compose service over the internal network.
#
# Path matchers below mirror src/api/main.py exactly. Tight on purpose:
# trailing `*` was hijacking sibling Next routes — /papers/<stem> is a
# Next page, /papers/<stem>/pdf is the FastAPI raw-PDF endpoint, and
# whoever shadows the other wins. /viewer/* used to belong to FastAPI
# (the static viewer.html shim) but is now a Next App Router route; the
# matcher no longer includes it. Any new FastAPI route must be added
# here AND the Next config's rewrites() block.

{
	email ops@efferon.com
}

# NOTE: the container HEALTHCHECK in docker/Dockerfile.frontend probes
# `http://localhost:80/` with `Host: atlas.efferon.com`, relying on this
# hostname matching the site block below. If you rename the host or split
# this block, update the HEALTHCHECK Host header too — otherwise Caddy
# rejects the probe (no matching site = wget exit 4) and the container
# stays `unhealthy` forever even though external traffic still works.
atlas.efferon.com {
	encode zstd gzip

	# Server-side directives that shouldn't live in the public repo
	# (basic-auth credential hash, IP allow-lists, etc.). Empty dir = no-op.
	import /etc/caddy/conf.d/*.caddy

	# Backend API routes — keep in sync with @app.{get,post} in src/api/main.py
	# and the rewrites() block in web/next.config.ts. Raw PDFs are served by
	# Next from web/public/pdfs/<stem>.pdf, not by FastAPI, so /papers/*/pdf
	# (which used to be in this matcher) does not belong here.
	@api {
		path /query
		path /rank_predictors
		path /ingest_pubmed
		path /health
		path /health/cost
		path /phenotypes
		path /phenotypes/*
		path /static/*
	}
	handle @api {
		reverse_proxy backend:8000
	}

	# Lock down Next's ISR-flush endpoint. Only the Python exporter on the
	# compose network should reach it (via the backend service hitting
	# localhost:3000 directly inside the frontend container, bypassing
	# Caddy entirely). External traffic gets a 404.
	@revalidate path /api/revalidate
	handle @revalidate {
		respond 404
	}

	# Everything else (chrome routes, /papers/<stem>, /viewer/<stem>,
	# /_next/* asset chunks, items in public/) is served by Next. Next
	# emits its own cache-control headers; let it answer.
	handle {
		reverse_proxy localhost:3000
	}
}
