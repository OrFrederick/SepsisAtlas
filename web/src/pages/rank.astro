---
import Base from "../layouts/Base.astro";
import "../styles/tailwind.css";

const backendUrl = (import.meta.env.PUBLIC_BACKEND_URL || "").replace(/\/$/, "");
---
<Base title="Sepsis Atlas — Rank predictors" route="rank">
  <h1 style="margin: 0 0 12px; font-size: 18px;">Rank predictors</h1>
  <p style="color: var(--fg-muted); margin: 0 0 16px;">
    Pick an outcome and (optionally) a window. Predictors are ranked by
    best-available metric: AUC &gt; c-index &gt; OR &gt; HR &gt; RR.
  </p>

  <form id="rank-form" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; align-items: end;">
    <label style="display: flex; flex-direction: column; gap: 2px; font-size: 12px;">
      Outcome type
      <select id="f-outcome-type" style="padding: 4px 6px;">
        <option value="mortality" selected>mortality</option>
        <option value="readmission">readmission</option>
        <option value="los">los</option>
        <option value="organ_failure">organ_failure</option>
        <option value="other">other</option>
      </select>
    </label>
    <label style="display: flex; flex-direction: column; gap: 2px; font-size: 12px;">
      Window (days)
      <select id="f-window" style="padding: 4px 6px;">
        <option value="">any</option>
        <option value="28" selected>28</option>
        <option value="30">30</option>
        <option value="60">60</option>
        <option value="90">90</option>
        <option value="180">180</option>
        <option value="365">365</option>
      </select>
    </label>
    <label style="display: flex; flex-direction: column; gap: 2px; font-size: 12px;">
      Paper ref
      <input id="f-paper" type="text" placeholder="Schlapbach 2018" style="padding: 4px 6px;" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 2px; font-size: 12px;">
      Population contains
      <input id="f-pop" type="text" placeholder="ICU / pediatric / ..." style="padding: 4px 6px;" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 2px; font-size: 12px;">
      Top K
      <input id="f-topk" type="number" min="1" max="200" value="50" style="padding: 4px 6px; width: 80px;" />
    </label>
    <button type="submit" style="padding: 6px 14px; font-weight: 600;">Rank</button>
  </form>

  <div id="rank-banner" style="display: none; padding: 8px 12px; margin-bottom: 8px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 4px; font-size: 13px;"></div>
  <div id="rank-status" style="font-size: 12px; color: var(--fg-muted); margin-bottom: 8px;">Submit to load ranking.</div>
  <div id="rank-table-wrap"></div>

  <script define:vars={{ backendUrl }}>
    const BACKEND_URL = backendUrl;
    const $ = (id) => document.getElementById(id);

    // All DOM construction below uses createElement + textContent. No innerHTML
    // assignments, so paper/anchor strings can never be interpreted as HTML.
    function el(tag, attrs, kids) {
      const n = document.createElement(tag);
      if (attrs) {
        for (const k in attrs) {
          if (k === "style") n.setAttribute("style", attrs[k]);
          else if (k === "text") n.textContent = attrs[k];
          else n.setAttribute(k, attrs[k]);
        }
      }
      if (kids) for (const c of kids) if (c != null) n.appendChild(c);
      return n;
    }
    const tn = (s) => document.createTextNode(s == null ? "" : String(s));

    function fmtVal(metric, v, lo, hi) {
      if (v == null) return "—";
      const isAuc = metric === "AUC" || metric === "c_index";
      const s = isAuc ? Number(v).toFixed(3) : Number(v).toFixed(2);
      if (lo != null && hi != null) {
        return `${s} (${Number(lo).toFixed(2)}–${Number(hi).toFixed(2)})`;
      }
      return s;
    }

    function viewerHref(row) {
      const origin = BACKEND_URL || window.location.origin;
      const stem = row.file_name || row.paper_ref || "";
      let page = parseInt(row.anchor_page ?? "", 10);
      if (!Number.isFinite(page) || page < 1) page = 1;
      let url = `${origin}/viewer/${encodeURIComponent(stem)}?page=${page}`;
      const bbox = row.anchor_bbox;
      if (Array.isArray(bbox) && bbox.length === 4) {
        url += `&bbox=${bbox.map((v) => Number(v).toFixed(2)).join(",")}&origin=tl`;
      }
      return url;
    }

    function effectStr(sr) {
      if (sr.effect_size_str) return sr.effect_size_str;
      if (sr.auc != null) return `AUC ${Number(sr.auc).toFixed(3)}`;
      if (sr.c_index != null) return `c-index ${Number(sr.c_index).toFixed(3)}`;
      if (sr.effect_type && sr.effect_value != null) {
        return `${sr.effect_type} ${Number(sr.effect_value).toFixed(2)}`;
      }
      return "—";
    }

    function buildSupportingTable(supRows) {
      const t = el("table", { style: "width: 100%; font-size: 12px; border-collapse: collapse;" });
      const thead = el("thead");
      const hr = el("tr");
      ["Paper", "Cohort", "Predictor", "Effect", "Page", "Anchor"].forEach((h) => {
        hr.appendChild(el("th", { style: "text-align: left; padding: 4px 6px; border-bottom: 1px solid #ddd;", text: h }));
      });
      thead.appendChild(hr);
      t.appendChild(thead);
      const tb = el("tbody");
      supRows.forEach((sr) => {
        const tr = el("tr");
        tr.appendChild(el("td", { style: "padding: 4px 6px;", text: sr.paper_ref || "—" }));
        tr.appendChild(el("td", { style: "padding: 4px 6px;", text: sr.cohort_label || sr.cohort_id || "—" }));
        tr.appendChild(el("td", { style: "padding: 4px 6px;", text: sr.predictor || "—" }));
        tr.appendChild(el("td", { style: "padding: 4px 6px; font-family: ui-monospace, monospace;", text: effectStr(sr) }));
        const tdPage = el("td", { style: "padding: 4px 6px;" });
        if (sr.anchor_page) {
          const a = el("a", { href: viewerHref(sr), target: "_blank", rel: "noopener" });
          a.textContent = `p.${sr.anchor_page}`;
          tdPage.appendChild(a);
        } else {
          tdPage.textContent = "—";
        }
        tr.appendChild(tdPage);
        const anchorTxt = sr.anchor_text ? String(sr.anchor_text).slice(0, 140) : "";
        tr.appendChild(el("td", { style: "padding: 4px 6px; color: #555; font-style: italic;", text: anchorTxt }));
        tb.appendChild(tr);
      });
      t.appendChild(tb);
      return t;
    }

    function renderTable(payload) {
      const wrap = $("rank-table-wrap");
      wrap.replaceChildren();
      const banner = $("rank-banner");
      if (payload.fallback_note) {
        banner.style.display = "block";
        banner.textContent = payload.fallback_note;
      } else {
        banner.style.display = "none";
        banner.textContent = "";
      }
      const rows = payload.rows || [];
      if (rows.length === 0) {
        const p = el("p", { style: "color: var(--fg-muted);", text: "No predictors ranked for these filters." });
        wrap.appendChild(p);
        return;
      }
      const table = el("table", { style: "width: 100%; border-collapse: collapse; font-size: 13px;" });
      const thead = el("thead");
      const hrow = el("tr");
      ["#", "Predictor", "Best metric", "Best value (CI)", "# studies", "Top study", ""].forEach((h) => {
        hrow.appendChild(el("th", { style: "text-align: left; padding: 6px 8px; border-bottom: 2px solid #ccc;", text: h }));
      });
      thead.appendChild(hrow);
      table.appendChild(thead);
      const tb = el("tbody");
      rows.forEach((r, i) => {
        const tr = el("tr", { style: "border-bottom: 1px solid #eee;" });
        tr.appendChild(el("td", { style: "padding: 6px 8px;", text: String(i + 1) }));
        tr.appendChild(el("td", { style: "padding: 6px 8px; font-weight: 600;", text: r.predictor_canonical }));
        tr.appendChild(el("td", { style: "padding: 6px 8px;", text: r.best_metric }));
        tr.appendChild(el("td", { style: "padding: 6px 8px; font-family: ui-monospace, monospace;", text: fmtVal(r.best_metric, r.best_value, r.best_ci_lo, r.best_ci_hi) }));
        tr.appendChild(el("td", { style: "padding: 6px 8px;", text: String(r.n_studies) }));
        tr.appendChild(el("td", { style: "padding: 6px 8px;", text: r.best_paper_ref || "—" }));
        const tdBtn = el("td", { style: "padding: 6px 8px;" });
        const btn = el("button", { type: "button", style: "font-size: 12px; padding: 2px 8px;", text: "Details" });
        tdBtn.appendChild(btn);
        tr.appendChild(tdBtn);
        tb.appendChild(tr);

        // Drawer row (hidden by default).
        const drawer = el("tr", { style: "display: none; background: #f8fafc;" });
        const drawerTd = el("td", { colspan: "7", style: "padding: 8px 12px;" });
        if (r.supporting_rows && r.supporting_rows.length) {
          drawerTd.appendChild(buildSupportingTable(r.supporting_rows));
        } else {
          drawerTd.appendChild(el("em", { style: "color: var(--fg-muted);", text: "No supporting rows." }));
        }
        drawer.appendChild(drawerTd);
        tb.appendChild(drawer);

        btn.addEventListener("click", () => {
          drawer.style.display = drawer.style.display === "none" ? "" : "none";
        });
      });
      table.appendChild(tb);
      wrap.appendChild(table);
    }

    async function submit(ev) {
      if (ev) ev.preventDefault();
      const body = {
        outcome_type: $("f-outcome-type").value || null,
        outcome_window_days: $("f-window").value ? parseInt($("f-window").value, 10) : null,
        paper_ref: $("f-paper").value.trim() || null,
        population_contains: $("f-pop").value.trim() || null,
        top_k: parseInt($("f-topk").value, 10) || 50,
      };
      $("rank-status").textContent = "Loading…";
      try {
        const url = (BACKEND_URL || "") + "/rank_predictors";
        const resp = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!resp.ok) {
          $("rank-status").textContent = `Request failed: ${resp.status}`;
          return;
        }
        const payload = await resp.json();
        $("rank-status").textContent = `${payload.n_predictors} predictor(s) ranked.`;
        renderTable(payload);
      } catch (err) {
        const msg = err && err.message ? err.message : "unknown";
        $("rank-status").textContent = `Network error: ${msg}`;
      }
    }

    document.getElementById("rank-form").addEventListener("submit", submit);
    // Auto-submit on first load so the page is useful immediately.
    submit();
  </script>
</Base>
