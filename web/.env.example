# Next.js public vars (available in browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Server-only vars
NODE_ENV=development
REVALIDATE_TOKEN=                        # arbitrary secret; used to trigger ISR revalidation
API_URL=http://localhost:8000            # SSR-side backend URL (Caddy proxies the public side)

# Feedback → GitHub Issues (server-only)
GITHUB_FEEDBACK_TOKEN=ghp_xxx            # fine-grained PAT, Issues r/w on this repo only
GITHUB_FEEDBACK_REPO=OrFrederick/SepsisAtlas
FEEDBACK_ALLOWED_ORIGIN=https://your-prod-host  # comma-separated allowed origins
FEEDBACK_MOUNT_SECRET=                   # >=16 random bytes (e.g. `openssl rand -hex 32`); HMACs the mount-time token
