---
interface Props {
  stem: string;
}
const { stem } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---
<link rel="stylesheet" href={`${b}pdfjs/web/pdf_viewer.css`} />
<style>
  body { margin: 0; background: var(--panel-3); }
  #viewer-toolbar {
    position: sticky; top: 48px; z-index: 10;
    display: flex; gap: 8px; align-items: center;
    padding: 10px 18px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  #viewer-toolbar .sep { width: 1px; height: 20px; background: var(--border); margin: 0 6px; }
  #viewer-toolbar button {
    background: var(--panel); color: var(--fg-soft);
    border: 1px solid var(--border);
    padding: 5px 12px; border-radius: 4px; cursor: pointer;
    font-size: 12.5px;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  #viewer-toolbar button:hover:not(:disabled) {
    background: var(--panel-2);
    border-color: var(--border-strong);
    color: var(--fg);
  }
  #viewer-toolbar button:disabled { opacity: 0.4; cursor: default; }
  #pageinfo {
    color: var(--fg-muted); min-width: 80px; text-align: center;
    font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
  }
  #zoominfo {
    color: var(--fg-muted); min-width: 50px; text-align: center;
    font-feature-settings: "tnum"; font-variant-numeric: tabular-nums;
  }
  #vstatus { color: var(--fg-muted); font-style: italic; }
  #filename {
    color: var(--fg-muted); margin-left: auto;
    font-family: var(--mono); font-size: 12px;
    font-feature-settings: "tnum";
  }
  #stage {
    display: flex; flex-direction: column; align-items: center;
    padding: 28px 16px 80px; gap: 22px;
    background: var(--panel-3);
  }
  .pageWrap {
    position: relative;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: 0 1px 0 rgba(0,0,0,0.02), 0 8px 24px rgba(26, 22, 20, 0.06);
  }
  .pdfCanvas { position: absolute; left: 0; top: 0; }
  .textLayer {
    position: absolute; left: 0; top: 0; overflow: hidden;
    opacity: 1; line-height: 1.0; user-select: text;
    forced-color-adjust: none;
  }
  .textLayer ::selection { background: rgba(15, 76, 92, 0.25); }
  .textLayer span, .textLayer br {
    color: transparent; position: absolute; white-space: pre;
    cursor: text; transform-origin: 0% 0%;
  }
  .bboxOverlay {
    position: absolute; pointer-events: none;
    background: rgba(255, 226, 92, 0.55);
    mix-blend-mode: multiply; border-radius: 1px; display: none;
    box-shadow: 0 0 0 1px rgba(204, 150, 16, 0.55);
  }
  .pageLabel {
    position: absolute; left: 10px; top: 10px;
    color: var(--fg-faint); font-size: 11px;
    font-family: var(--mono);
    font-feature-settings: "tnum"; pointer-events: none;
  }
  /* Viewer pages need to escape the narrow main container. */
  main { max-width: none; padding: 0; }
</style>

<div id="viewer-toolbar">
  <button id="prev" title="Previous page (←, PageUp)">‹</button>
  <span id="pageinfo">— / —</span>
  <button id="next" title="Next page (→, PageDown)">›</button>
  <span class="sep"></span>
  <button id="zoomOut" title="Zoom out (-)">−</button>
  <span id="zoominfo">100%</span>
  <button id="zoomIn" title="Zoom in (+)">+</button>
  <button id="fit" title="Fit width">Fit</button>
  <span class="sep"></span>
  <button id="jumpBbox" title="Jump back to highlight">↩ Highlight</button>
  <span id="vstatus"></span>
  <span id="filename">{stem}.pdf</span>
</div>
<div id="stage"></div>

<script type="module" define:vars={{ stem, base: b }}>
  if ("scrollRestoration" in history) history.scrollRestoration = "manual";
  const pdfjsLib = await import(`${base}pdfjs/build/pdf.min.mjs`);
  pdfjsLib.GlobalWorkerOptions.workerSrc = `${base}pdfjs/build/pdf.worker.min.mjs`;

  const FILE_STEM = stem;
  const PDF_URL = `${base}pdfs/${encodeURIComponent(FILE_STEM)}.pdf`;

  const params = new URLSearchParams(location.search);
  const initialPage = Math.max(1, parseInt(params.get("page") || "1", 10));
  const bboxStr = params.get("bbox");
  const bboxOrigin = (params.get("origin") || "tl").toLowerCase();
  const bbox = bboxStr ? bboxStr.split(",").map(Number) : null;
  const bboxPage = bbox ? initialPage : null;

  let scale = 1.5;
  let pdfDoc = null;
  let currentPage = initialPage;
  const dpr = Math.min(window.devicePixelRatio || 1, 2.5);

  const stage = document.getElementById("stage");
  const statusEl = document.getElementById("vstatus");
  const pageInfoEl = document.getElementById("pageinfo");
  const zoomInfoEl = document.getElementById("zoominfo");
  const prevBtn = document.getElementById("prev");
  const nextBtn = document.getElementById("next");
  const fitBtn = document.getElementById("fit");
  const jumpBtn = document.getElementById("jumpBbox");

  const pages = [];
  let renderObserver = null;
  let visibilityObserver = null;

  const setStatus = (m) => (statusEl.textContent = m);

  function buildPageStub(num, viewport) {
    const cssW = Math.floor(viewport.width);
    const cssH = Math.floor(viewport.height);
    const wrap = document.createElement("div");
    wrap.className = "pageWrap";
    wrap.dataset.page = String(num);
    wrap.style.width = `${cssW}px`;
    wrap.style.height = `${cssH}px`;

    const canvas = document.createElement("canvas");
    canvas.className = "pdfCanvas";
    canvas.style.width = `${cssW}px`;
    canvas.style.height = `${cssH}px`;
    wrap.appendChild(canvas);

    const textLayer = document.createElement("div");
    textLayer.className = "textLayer";
    textLayer.style.width = `${cssW}px`;
    textLayer.style.height = `${cssH}px`;
    wrap.appendChild(textLayer);

    const overlay = document.createElement("div");
    overlay.className = "bboxOverlay";
    wrap.appendChild(overlay);

    const label = document.createElement("div");
    label.className = "pageLabel";
    label.textContent = String(num);
    wrap.appendChild(label);

    stage.appendChild(wrap);
    return { num, wrap, canvas, textLayer, overlay, rendered: false, rendering: null };
  }

  async function renderPage(entry) {
    if (!pdfDoc) return;
    if (entry.rendered) return;
    if (entry.rendering) return entry.rendering;

    entry.rendering = (async () => {
      const page = await pdfDoc.getPage(entry.num);
      const viewport = page.getViewport({ scale });
      const cssW = Math.floor(viewport.width);
      const cssH = Math.floor(viewport.height);

      entry.wrap.style.width = `${cssW}px`;
      entry.wrap.style.height = `${cssH}px`;
      entry.canvas.width = Math.floor(cssW * dpr);
      entry.canvas.height = Math.floor(cssH * dpr);
      entry.canvas.style.width = `${cssW}px`;
      entry.canvas.style.height = `${cssH}px`;
      entry.textLayer.style.width = `${cssW}px`;
      entry.textLayer.style.height = `${cssH}px`;

      const ctx = entry.canvas.getContext("2d", { alpha: false });
      const transform = dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : null;
      await page.render({ canvasContext: ctx, viewport, transform }).promise;

      entry.textLayer.replaceChildren();
      const textLayer = new pdfjsLib.TextLayer({
        textContentSource: page.streamTextContent(),
        container: entry.textLayer,
        viewport,
      });
      await textLayer.render();

      drawBbox(entry, viewport);
      entry.rendered = true;
    })();

    try { await entry.rendering; }
    finally { entry.rendering = null; }
  }

  function drawBbox(entry, viewport) {
    const overlay = entry.overlay;
    overlay.style.display = "none";
    if (!bbox || bbox.length !== 4 || entry.num !== bboxPage) return;

    let [x0, y0, x1, y1] = bbox;
    if (bboxOrigin === "bl") {
      const pageHeightPts = viewport.height / scale;
      const yMin = Math.min(y0, y1);
      const yMax = Math.max(y0, y1);
      y0 = pageHeightPts - yMax;
      y1 = pageHeightPts - yMin;
    } else if (y0 > y1) {
      [y0, y1] = [y1, y0];
    }
    const left = x0 * scale;
    const top = y0 * scale;
    const w = Math.max(2, (x1 - x0) * scale);
    const h = Math.max(2, (y1 - y0) * scale);
    overlay.style.left = `${left}px`;
    overlay.style.top = `${top}px`;
    overlay.style.width = `${w}px`;
    overlay.style.height = `${h}px`;
    overlay.style.display = "block";
  }

  function scrollToPage(num, opts = {}) {
    const entry = pages[num - 1];
    if (!entry) return;
    entry.wrap.scrollIntoView({ behavior: opts.behavior || "auto", block: "start" });
  }

  function scrollToBbox(opts = {}) {
    const entry = pages[bboxPage - 1];
    if (!entry || !bbox) return;
    const ensure = entry.rendered ? Promise.resolve() : renderPage(entry);
    ensure.then(() => {
      const overlay = entry.overlay;
      if (overlay.style.display === "none") {
        scrollToPage(bboxPage, opts);
        return;
      }
      const scroller = document.scrollingElement || document.documentElement;
      const wrapRect = entry.wrap.getBoundingClientRect();
      const overlayTop = parseFloat(overlay.style.top) || 0;
      const overlayHeight = parseFloat(overlay.style.height) || 0;
      const targetY = scroller.scrollTop + wrapRect.top + overlayTop
                      - window.innerHeight / 2 + overlayHeight / 2;
      scroller.scrollTo({ top: Math.max(0, targetY), behavior: opts.behavior || "auto" });
    });
  }

  async function rerenderAll() {
    for (const entry of pages) {
      const page = await pdfDoc.getPage(entry.num);
      const viewport = page.getViewport({ scale });
      const cssW = Math.floor(viewport.width);
      const cssH = Math.floor(viewport.height);
      entry.wrap.style.width = `${cssW}px`;
      entry.wrap.style.height = `${cssH}px`;
      entry.canvas.style.width = `${cssW}px`;
      entry.canvas.style.height = `${cssH}px`;
      entry.textLayer.style.width = `${cssW}px`;
      entry.textLayer.style.height = `${cssH}px`;
      entry.rendered = false;
    }
    zoomInfoEl.textContent = `${Math.round(scale / 1.5 * 100)}%`;
    if (renderObserver) {
      for (const entry of pages) {
        renderObserver.unobserve(entry.wrap);
        renderObserver.observe(entry.wrap);
      }
    }
  }

  function fitWidth() {
    if (!pdfDoc || !pages[0]) return;
    pdfDoc.getPage(1).then((page) => {
      const baseViewport = page.getViewport({ scale: 1 });
      const available = stage.clientWidth - 32;
      scale = Math.max(0.5, Math.min(4, available / baseViewport.width));
      rerenderAll();
    });
  }

  function setupObservers() {
    renderObserver = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const num = parseInt(e.target.dataset.page, 10);
        const entry = pages[num - 1];
        if (entry) renderPage(entry);
      }
    }, { rootMargin: "600px 0px 600px 0px" });

    visibilityObserver = new IntersectionObserver((entries) => {
      let best = null;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
      }
      if (!best) return;
      const num = parseInt(best.target.dataset.page, 10);
      if (!Number.isFinite(num) || num === currentPage) return;
      currentPage = num;
      updateNavUi();
    }, { threshold: [0.25, 0.5, 0.75] });

    for (const entry of pages) {
      renderObserver.observe(entry.wrap);
      visibilityObserver.observe(entry.wrap);
    }
  }

  function updateNavUi() {
    pageInfoEl.textContent = `${currentPage} / ${pdfDoc.numPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= pdfDoc.numPages;
  }

  async function init() {
    try {
      setStatus("loading…");
      pdfDoc = await pdfjsLib.getDocument({
        url: PDF_URL,
        cMapUrl: `${base}pdfjs/cmaps/`,
        cMapPacked: true,
      }).promise;

      const total = pdfDoc.numPages;
      for (let n = 1; n <= total; n++) {
        const page = await pdfDoc.getPage(n);
        const viewport = page.getViewport({ scale });
        pages.push(buildPageStub(n, viewport));
      }

      currentPage = Math.min(initialPage, total);
      updateNavUi();
      zoomInfoEl.textContent = `${Math.round(scale / 1.5 * 100)}%`;
      jumpBtn.style.display = bbox ? "" : "none";

      setupObservers();
      setStatus("");

      // Capture target page in a local before observers can clobber it.
      const targetPage = currentPage;
      const target = pages[targetPage - 1];
      if (target) {
        await renderPage(target);
        const jump = () => {
          if (bbox && targetPage === bboxPage) scrollToBbox({ behavior: "auto" });
          else scrollToPage(targetPage, { behavior: "auto" });
        };
        requestAnimationFrame(() => requestAnimationFrame(() => {
          jump();
          setTimeout(jump, 250);
        }));
      }
    } catch (err) {
      setStatus("Error: " + err.message);
      console.error(err);
    }
  }

  prevBtn.addEventListener("click", () => {
    if (currentPage > 1) scrollToPage(currentPage - 1);
  });
  nextBtn.addEventListener("click", () => {
    if (pdfDoc && currentPage < pdfDoc.numPages) scrollToPage(currentPage + 1);
  });
  document.getElementById("zoomIn").addEventListener("click", () => {
    scale = Math.min(4, scale * 1.2); rerenderAll();
  });
  document.getElementById("zoomOut").addEventListener("click", () => {
    scale = Math.max(0.5, scale / 1.2); rerenderAll();
  });
  fitBtn.addEventListener("click", fitWidth);
  jumpBtn.addEventListener("click", () => scrollToBbox());

  document.addEventListener("keydown", (e) => {
    if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
    if (e.ctrlKey || e.metaKey) return;
    if ((e.key === "ArrowLeft" || e.key === "PageUp") && currentPage > 1) {
      e.preventDefault(); scrollToPage(currentPage - 1);
    } else if ((e.key === "ArrowRight" || e.key === "PageDown") && pdfDoc && currentPage < pdfDoc.numPages) {
      e.preventDefault(); scrollToPage(currentPage + 1);
    } else if (e.key === "+" || e.key === "=") {
      scale = Math.min(4, scale * 1.2); rerenderAll();
    } else if (e.key === "-") {
      scale = Math.max(0.5, scale / 1.2); rerenderAll();
    } else if (e.key === "0") {
      scale = 1.5; rerenderAll();
    }
  });

  init();
</script>
