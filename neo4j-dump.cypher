UNWIND [{id:\"03ba806e3af44234236d0aae\", properties:{predictors:\"APACHE II score\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"APACHE II score       |        1.021 | 0.985 - 1.006 |      0.403 |\", is_significant:false, verifier_score:1.0, model_specification:\"Univariate binary logistic regression (Table 2)\", predictor_canonical:\"APACHE_II\", ci_lo:0.985, anchor_section:\"Table 2\", ci_hi:1.006, outcome:\"In-hospital mortality\", anchor_bbox:\"null\", p_value:0.403, verifier_verdict:\"ok\", timing:\"Upon admission\", adjustment_kind:\"univariate\", paper_file_name:\"Wen_2019\", effect_value:1.021, anchor_page:5, effect_type:\"OR\", cohort_id:\"Wen 2019  Total Cohort\", outcome_type:\"mortality\", effect_size_str:\"OR 1.021 (95% CI 0.985 - 1.006), P=0.403\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"1ca39d3940dbdfec98200aae\", properties:{predictors:\"SOFA score\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"SOFA score            |        1.404 | 1.209 - 1.632 |      0.000 |\", is_significant:true, verifier_score:1.0, model_specification:\"Univariate binary logistic regression (Table 2)\", predictor_canonical:\"SOFA\", ci_lo:1.209, anchor_section:\"Table 2\", ci_hi:1.632, outcome:\"In-hospital mortality\", anchor_bbox:\"null\", p_value:0.0, verifier_verdict:\"ok\", timing:\"Upon admission\", adjustment_kind:\"univariate\", paper_file_name:\"Wen_2019\", effect_value:1.404, anchor_page:5, effect_type:\"OR\", cohort_id:\"Wen 2019  Total Cohort\", outcome_type:\"mortality\", effect_size_str:\"OR 1.404 (95% CI 1.209 - 1.632), P=0.000\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"3c70ee74aa4f69d518ac4b05\", properties:{p_value:0.905, predictors:\"Gastrointestinal system (source of infection)\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Gastrointestinal system | 74 (13.5) | 65 (13.5) | 9 (13.0) | 0.905\", verifier_verdict:\"ok\", timing:\"At ED triage\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Suttapanit_2022\", anchor_page:6, effect_type:\"other\", cohort_id:\"Suttapanit 2022  Total Cohort\", outcome_window_days:28, verifier_score:0.95, model_specification:\"Naive model, Comparison of survivors vs non-survivors (chi-square/Fisher), Univariate analysis\", predictor_canonical:\"gi_infection\", outcome_type:\"mortality\", effect_size_str:\"All: 74 (13.5%); Survivor: 65 (13.5%); Non-survivor: 9 (13.0%); p=0.905\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"28-day mortality\", anchor_bbox:\"null\"}}, {id:\"1c6d14960246eb67e784cc80\", properties:{predictors:\"Presepsin (pg/mL)\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The levels of presepsin and lactate had good performance in predicting the prognosis of sepsis (presepsin: AUC =0.703, P =0.000; lactate: AUC =0.711, P =0.000). The SOFA score had the best performance with the highest AUC value (AUC =0.793, P =0.000). Furthermore, the AUC value of a combination of the SOFA score and the presepsin level was significantly higher than that of the SOFA score alone in predicting patients ' in-hospital mortality (AUC: 0.817 vs 0.793, P =0.041). The best prognostic cutoff point for presepsin was 2,623 pg/mL, at which level the sensitivity and specificity were 62.71% (95% CI: 49.15% to 74.96%) and 72.6% (95% CI: 60.91% to 82.39%), respectively.\", is_significant:true, auc_ci_hi:0.793, auc_ci_lo:0.614, verifier_score:0.98, model_specification:\"ROC curve analysis\", predictor_canonical:\"presepsin\", ci_lo:0.614, anchor_section:\"Prognostic value of the presepsin level, lactate level, and SOFA score\", ci_hi:0.793, outcome:\"In-hospital mortality\", anchor_bbox:\"null\", p_value:0.0, verifier_verdict:\"ok\", timing:\"Upon admission\", paper_file_name:\"Wen_2019\", effect_value:0.703, anchor_page:3, effect_type:\"AUC\", cohort_id:\"Wen 2019  Total Cohort\", auc:0.703, outcome_type:\"mortality\", effect_size_str:\"AUC =0.703 (95% CI: 0.614 to 0.793), P=0.000; cutoff 2,623 pg/mL; sensitivity 62.71% (95% CI: 49.15% to 74.96%); specificity 72.6% (95% CI: 60.91% to 82.39%)\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"ee99de218dfb789ae470c70e\", properties:{predictors:\"Lactate (mmol/L)\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Areas under the receiver operating characteristic (ROC) curves: the lactate level (blue line): 0.711 (95% con fi dence interval (CI): 0.622 to 0.800, P =0.000); the presepsin level (red line): 0.703 (95% CI: 0.614 to 0.793, P =0.000); the SOFA score (green line): 0.793 (95% CI: 0.716 to 0.870, P =0.000); the SOFA score + the presepsin level (purple line): 0.817 (95% CI: 0.742 to 0.892, P =0.000).\", is_significant:true, auc_ci_hi:0.8, auc_ci_lo:0.622, verifier_score:1.0, model_specification:\"ROC curve analysis\", predictor_canonical:\"lactate\", ci_lo:0.622, anchor_section:\"Discussion\", ci_hi:0.8, outcome:\"In-hospital mortality\", anchor_bbox:\"null\", p_value:0.0, verifier_verdict:\"ok\", timing:\"Upon admission\", paper_file_name:\"Wen_2019\", effect_value:0.711, anchor_page:4, effect_type:\"AUC\", cohort_id:\"Wen 2019  Total Cohort\", auc:0.711, outcome_type:\"mortality\", effect_size_str:\"AUC =0.711 (95% CI: 0.622 to 0.800), P=0.000\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"3c5bc93fad0eef9ad4e9a53a\", properties:{predictors:\"SOFA score\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Areas under the receiver operating characteristic (ROC) curves: the lactate level (blue line): 0.711 (95% con fi dence interval (CI): 0.622 to 0.800, P =0.000); the presepsin level (red line): 0.703 (95% CI: 0.614 to 0.793, P =0.000); the SOFA score (green line): 0.793 (95% CI: 0.716 to 0.870, P =0.000); the SOFA score + the presepsin level (purple line): 0.817 (95% CI: 0.742 to 0.892, P =0.000).\", is_significant:true, auc_ci_hi:0.87, auc_ci_lo:0.716, verifier_score:1.0, model_specification:\"ROC curve analysis\