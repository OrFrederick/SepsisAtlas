---
// Search input. Dispatches CustomEvent("atlas:search", { detail: { query } }).
---
<form class="searchbox" id="atlas-searchbox" autocomplete="off">
  <textarea
    id="atlas-query"
    placeholder="Ask about sepsis predictors, mortality, cohorts… (Enter to send, Shift+Enter for newline)"
    rows="1"
  ></textarea>
  <button type="submit" id="atlas-send">Send</button>
</form>
<script>
  const form = document.getElementById("atlas-searchbox") as HTMLFormElement;
  const ta = document.getElementById("atlas-query") as HTMLTextAreaElement;
  const btn = document.getElementById("atlas-send") as HTMLButtonElement;

  function autoresize() {
    ta.style.height = "auto";
    ta.style.height = Math.min(200, ta.scrollHeight) + "px";
  }
  ta.addEventListener("input", autoresize);

  ta.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const query = ta.value.trim();
    if (!query) return;
    btn.disabled = true;
    document.dispatchEvent(
      new CustomEvent("atlas:search", { detail: { query } }),
    );
    setTimeout(() => (btn.disabled = false), 50);
  });

  document.addEventListener("atlas:fill-query", (e: Event) => {
    const ce = e as CustomEvent<{ query: string }>;
    ta.value = ce.detail.query;
    autoresize();
    form.requestSubmit();
  });
</script>
