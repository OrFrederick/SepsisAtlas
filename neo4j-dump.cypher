hort\", paper_file_name:\"Cilloniz_2019\", n_predictor_models:70}}, {cohort_id:\"Cilloniz 2019  No-Sepsis subgroup\", properties:{predictors_canonical:[\"sepsis_status\", \"age\", \"male_sex\", \"current_smoker\", \"alcohol_use\", \"prior_antibiotic\", \"influenza_vaccine\", \"pneumococcal_vaccine\", \"inhaled_corticosteroids\", \"systemic_corticosteroids\", \"fever\", \"pleuritic_pain\", \"dyspnea\", \"cough\", \"altered_mental_status\", \"prior_pneumonia\", \"comorbidities\", \"chronic_respiratory_disease\", \"chronic_cardiovascular_disease\", \"diabetes_mellitus\", \"neurologic_disease\", \"chronic_renal_disease\", \"chronic_liver_disease\", \"nursing_home_resident\", \"respiratory_rate\", \"CRP\", \"lymphocytes\", \"neutrophils\", \"PSI\", \"severe_CAP\", \"bacteremia\", \"pleural_effusion\", \"multilobar_infiltrate\", \"septic_shock\", \"DNR_order\", \"monotherapy\", \"fluoroquinolones\", \"beta_lactams\", \"other_therapy\", \"combination_therapy\", \"beta_lactams_macrolides\", \"beta_lactams_fluoroquinolones\", \"appropriate_antibiotic\"], mortality_timepoint:\"30-day mortality\", population_description:\"Very old (≥80 years) patients hospitalized with CAP who did not meet Sepsis-3 criteria (SOFA score increase <2 points) at hospital admission\", cohort_size_n:\"358\", cohort_label:\"No-Sepsis subgroup\", paper_file_name:\"Cilloniz_2019\", mortality_rate_pct:11.0, n_predictor_models:50}}, {cohort_id:\"Cilloniz 2019  Sepsis subgroup\", properties:{predictors_canonical:[\"multivariable_model\", \"PSI\", \"nursing_home\", \"neurologic_chronic_disease\", \"diabetes_mellitus\", \"chronic_renal_disease\"], mortality_timepoint:\"30-day mortality\", population_description:\"Very old (≥80 years) patients hospitalized with CAP who met Sepsis-3 criteria (presence of pneumonia and SOFA score increase ≥2 points) at hospital admission\", cohort_size_n:\"880\", cohort_label:\"Sepsis subgroup\", paper_file_name:\"Cilloniz_2019\", mortality_rate_pct:15.0, n_predictor_models:9}