UNWIND [{id:\"0ccb3c6601dd79eb282e6571\", properties:{predictors:\"Septic shock\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Patients with septic shock had a nearly 3-fold increased risk of mortality than those without shock (OR 2.92, 95% CI 2.04-4.17, Table 7 ).\", verifier_verdict:\"ok\", timing:\"On admission to ICU or within first 48h\", is_significant:true, adjustment_kind:\"multivariate\", paper_file_name:\"Wang_2020\", effect_value:2.92, anchor_page:5, effect_type:\"OR\", cohort_id:\"Wang 2020 CCCST  Sepsis subgroup\", verifier_score:1.0, model_specification:\"Multivariable stepwise logistic regression (Table 7) adjusted for age, sex, APACHE II score, SOFA-initial score, comorbid conditions, use of MV, RRT and vasopressors, sites of infection, isolated organisms, use of antibiotics within 1h, use of antibiotics pre-sepsis, and septic shock\", predictor_canonical:\"septic_shock\", ci_lo:2.04, outcome_type:\"mortality\", effect_size_str:\"OR 2.92 (95% CI 2.04-4.17)\", anchor_section:\"Factors Associated With Mortality in All Patients With Sepsis\", prompt_id:\"predictor_extract_v1@618f1f75\", ci_hi:4.17, outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"3ccc79cb92ca31331d461d7e\", properties:{predictors:\"30 mL/kg fluid resuscitation within first 3 hours\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Achieving the resuscitation goal of 30 ml/kg during the first 3 h (OR 0.43, 95% CI, 0.30-0.63) and administering antibiotics within 1 h (OR 0.65, 95% CI, 0.46-0.92) of the onset of septic shock decreased the odds ratio for mortality in patients with septic shock ( Table 7 ).\", verifier_verdict:\"ok\", timing:\"Within first 3 hours of septic shock onset\", is_significant:true, adjustment_kind:\"multivariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_value:0.43, effect_type:\"OR\", cohort_id:\"Wang 2020 CCCST  Sepsis subgroup\", verifier_score:1.0, model_specification:\"Multivariable logistic regression (Table 7) adjusted for age, APACHE II score, SOFA-initial score, comorbid cardiovascular diseases, hypertension, diabetes mellitus and chronic renal failure, use of MV, RRT and vasopressors, administration of antibiotics within 1h, and 30 mL/kg fluid resuscitation within the first 3h of onset of septic shock or sepsis-induced hypoperfusion\", predictor_canonical:\"fluid_resuscitation_30ml_kg\", ci_lo:0.3, outcome_type:\"mortality\", effect_size_str:\"OR 0.43 (95% CI 0.30-0.63)\", anchor_section:\"Factors Associated With Mortality in All Patients With Sepsis\", prompt_id:\"predictor_extract_v1@618f1f75\", ci_hi:0.63, outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"cfd4b6c58a2bf7a7c42fa30c\", properties:{predictors:\"SOFA-respiratory sub-score\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"SOFA-respiratory                                                               | 3 (2-3)            | 3 (2-3)                           | 3 (2-4)                        | < 0.001\", verifier_verdict:\"ok\", timing:\"At onset of sepsis\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:7, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST  Sepsis subgroup\", verifier_score:1.0, model_specification:\"Naive model, Comparison of community-acquired vs hospital-acquired sepsis (Wilcoxon rank-sum), Univariate analysis\", predictor_canonical:\"SOFA_respiratory\", outcome_type:\"other\", effect_size_str:\"All sepsis: 3 (IQR 2-3); Community-acquired: 3 (IQR 2-3); Hospital-acquired: 3 (IQR 2-4), p<0.001\", anchor_section:\"TABLE 3 | Organ dysfunction scores, use of antibiotics, and use of nutritional therapy in patients with sepsis.\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"d8f5e7a3a98c4133480f3c43\", properties:{predictors:\"SOFA-cardiovascular sub-score\", p_value:0.012, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"SOFA-cardi