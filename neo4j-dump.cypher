UNWIND [{id:\"d0cb16bdb275822aaa1f70d2\", properties:{predictors:\"ICU length of stay\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"ICU                          | 6.0 (3.0-12.0)              | 4.0 (2.0-9.0)             | 8.0 (4.0-16.0)       | < 0.001\", verifier_verdict:\"ok\", timing:\"During ICU stay\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of non-sepsis vs sepsis (Wilcoxon rank-sum), Univariate analysis\", predictor_canonical:\"ICU_LOS\", outcome_type:\"los\", effect_size_str:\"4.0 (IQR 2.0-9.0) vs 8.0 (IQR 4.0-16.0) days, p<0.001\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"Sepsis (vs non-sepsis)\", anchor_bbox:\"null\"}}, {id:\"eb986ed7ffede756437e6123\", properties:{predictors:\"Hospital length of stay\", p_value:0.002, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Hospital                     | 17.0 (10.0-27.0)            | 17.0 (10.0-25.0)          | 18.0 (10.0-29.0)     | 0.002\", verifier_verdict:\"ok\", timing:\"During hospitalization\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of non-sepsis vs sepsis (Wilcoxon rank-sum), Univariate analysis\", predictor_canonical:\"hospital_LOS\", outcome_type:\"los\", effect_size_str:\"17.0 (IQR 10.0-25.0) vs 18.0 (IQR 10.0-29.0) days, p=0.002\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"Sepsis (vs non-sepsis)\", anchor_bbox:\"null\"}}, {id:\"6c14012d1769159f2fa530c1\", properties:{predictors:\"Sepsis (vs non-sepsis)\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"ICU                          | 834 (17.0)                  | 267 (9.5)                 | 567 (27.2)           | < 0.001\", verifier_verdict:\"ok\", timing:\"On admission to ICU or within first 48h\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of non-sepsis vs sepsis (chi-squared), Univariate analysis\", predictor_canonical:\"sepsis_status\", outcome_type:\"mortality\", effect_size_str:\"267 (9.5%) vs 567 (27.2%), p<0.001\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"4f16f6ffccedd2e8a78235c6\", properties:{predictors:\"Sepsis (vs non-sepsis)\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Hospital                     | 1,058 (21.5)                | 370 (13.1)                | 688 (33.0)           | < 0.001\", verifier_verdict:\"ok\", timing:\"On admission to ICU or within first 48h\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of non-sepsis vs sepsis (chi-squared), Univariate analysis\", predictor_canonical:\"sepsis_status\", outcome_type:\"mortality\", effect_size_str:\"370 (13.1%) vs 688 (33.0%), p<0.001\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"a87b06b5a028beb16d5d060e\", properties:{predictors:\"Septic shock\", p_value:0.028, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Septic shock, n (%) | 103 (47.0) | 66 (42.3) | 37 (58.7) | 0.028\", verifier_verdict:\"ok\", timing:\"At time of sepsis diagnosis (time zero)\", is_significant:true, adjustment_kind:\"univariate\", paper_fi