UNWIND [{cohort_id:\"Tang 2025 eICU-CRD  Total Cohort\", properties:{predictors_canonical:[\"MCV\", \"age\", \"gender\", \"BMI\", \"temperature\", \"respiratory_rate\", \"heart_rate\", \"MAP\", \"APS_III\", \"APACHE_IV\", \"lactate\", \"MCHC\", \"platelets\", \"hemoglobin\", \"RDW\", \"WBC\", \"AIDS\", \"hepatic_failure\", \"leukaemia\", \"immunosuppression\"], mortality_timepoint:\"28-day ICU mortality\", population_description:\"Patients with an initial diagnosis of sepsis based on ICD code A41.9 from the eICU Collaborative Research Database, excluding: (1) patients admitted to ICU more than once; (2) patients with ICU stays less than 48 hours; (3) patients for whom outcome data were unavailable; (4) patients for whom MCV data were unavailable within the first 24 hours of ICU admission.\", cohort_size_n:\"9415\", cohort_label:\"Total Cohort\", paper_file_name:\"Tang_2025\", mortality_rate_pct:9.38, n_predictor_models:56}}, {cohort_id:\"Baloch 2022  Total Cohort\", properties:{predictors_canonical:[\"pSOFA\", \"PRISM_III\", \"los\", \"inotrope_need\", \"ventilator_requirement\", \"admission_type\", \"weight\", \"age\"], mortality_timepoint:\"30-day mortality\", population_description:\"Critically ill children aged one month to 15 years of either gender staying in PICU for more than 24 hours. Excluded: patients with underlying congenital deformity hospitalized for routine treatment before planned procedures (IVIG, hemodialysis), CPR before admission, and children who died within 12 hours of admission.\", cohort_size_n:\"286\", cohort_label:\"Total Cohort\", paper_file_name:\"Baloch_2022\", mortality_rate_pct:57.0, n_predictor_models:16}}, {cohort_id:\"Besen 2016  Total Cohort\", properties:{predictors_canonical:[\"lactate\", \"multivariable_model\", \"sepsis_3_category\", \"sepsis_2_category\", \"mechanical_ventilation\", \"RRT\", \"SAPS3\", \"age\", \"gender\", \"SOFA\", \"vasopressors\", \"inotropes\", \"infection_source_respiratory\", \"infection_source_abdominal\", \"infection_source_urinary\", \"infection_source_skin\", \"febrile_neutropenia\", \"infection_source_catheter\", \"infection_source_bloodstream\", \"infection_source_osteoarticular\", \"infection_source_unidentifiable\", \"infection_source_other\", \"diabetes_mellitus\", \"chronic_heart_failure\", \"hypertension\", \"chronic_renal_failure\", \"rheumatologic_diseases\", \"COPD\", \"hematologic_cancer\", \"solid_cancer\", \"organ_transplantation\", \"AIDS\", \"liver_cirrhosis\", \"ICU_LOS\", \"days_mechanical_ventilation\", \"days_RRT\", \"days_vasopressors\"], mortality_timepoint:\"ICU mortality\", population_description:\"Patients diagnosed with sepsis admitted to a 19-bed ICU over a 6-year span, from January 2010 to December 2015, in a Brazilian academic tertiary medical center\", cohort_size_n:\"957\", cohort_label:\"Total Cohort\", paper_file_name:\"Besen_2016\", mortality_rate_pct:32.0, n_predictor_models:93}}, {cohort_id:\"Bidart 2024  Total Cohort\", properties:{predictors_canonical:[\"vasopressor\", \"severity_criteria\", \"qSOFA\", \"creatinine\", \"blood_culture_positive\", \"age\", \"time_to_ATB\", \"lactate\", \"platelets\"], mortality_timepoint:\"Overall mortality\", population_description:\"Adult patients (ages 18 and over) with suspicion of sepsis at the ED of a tertiary care hospital in Brazil, who scored two or more points on qSOFA score or at least one point on the severity criteria score. Exclusion criteria: patients in palliative care, patients diagnosed with COVID-19, patients whose access to medical records were restricted, patients diagnosed with other conditions, and pregnancy.\", cohort_size_n:\"665\", cohort_label:\"Total Cohort\", paper_file_name:\"Bidart_2024\", mortality_rate_pct:19.7, n_predictor_models:70}}, {cohort_id:\"Gai 2022  Total Cohort\", properties:{predictors_canonical:[\"PSV\", \"RI\", \"EDV\", \"lactate\", \"SOFA\", \"APACHE_II\", \"albumin\", \"CRP\", \"platelets\", \"norepinephrine_dose\", \"septic_shock\", \"infection_site\", \"CCI\", \"gender\", \"age\"], mortality_timepoint:\"In-Hospital Mortality\", population_description:\"Patients with sepsis admitted to the ICU meeting Sepsis 3.0 Criteria, with or without septic shock (within 1 hour of ICU admission), with available SMA ultrasound within the first 24 hours of ICU admission. Exclusion: age <18 years, pregnant women, patients unable to undergo ultrasound (abdominal surgery, severe bowel gas, Crohn's disease, ulcerative colitis, or short bowel syndrome).\", cohort_size_n:\"72\", cohort_label:\"Total Cohort\", paper_file_name:\"Gai_2022\", mortality_rate_pct:58.3, n_predictor_models:28}}, {cohort_id:\"Holanda 2020  Total Cohort\", properties:{predictors_canonical:[\"antibiotic_delay\", \"inadequate_hydration\", \"SOFA\", \"lactate\", \"vasopressors\", \"septic_shock\", \"other_infections\", \"urinary_infection\", \"uterine_infection\", \"respiratory_infection\", \"lifestyle_factors\", \"comorbidities\", \"obstetric_complications\", \"caesarean_section\", \"pregnant_at_sepsis\", \"transfer_from_another_hospital\", \"residence_outside_capital\", \"schooling\", \"multiparous\", \"nulliparous\", \"parity\", \"number_of_pregnancies\", \"age\"], mortality_timepoint:\"In-Hospital Mortality\", population_description:\"All patients admitted to the obstetric ICU between August 2012 and April 2016 whose discharge diagnosis was recorded as 'sepsis' in the ICU's discharge database, confirmed according to the criteria established at the 2001 Sepsis Definitions Conference (Sepsis-2); cases where diagnosis could not be confirmed, records were misplaced, or records had insufficient data were excluded.\", cohort_size_n:\"155\", cohort_label:\"Total Cohort\", paper_file_name:\"Holanda_2020\", mortality_rate_pct:14.2, n_predictor_models:28}}, {cohort_id:\"Wang 2020 CCCST  Total Cohort\", properties:{predictors_canonical:[\"fluid_resuscitation_30ml_kg\", \"antibiotics_within_1h\", \"septic_shock\", \"no_comorbidities\", \"RRT\", \"staphylococcus\"