# OpenRouter (required for extract / verify / intent / narrative)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing (override defaults from src/sepsis_atlas/config.py)
MODEL_EXTRACT=anthropic/claude-opus-4.7
MODEL_VERIFY=anthropic/claude-sonnet-4.6
MODEL_INTENT=anthropic/claude-haiku-4.5
MODEL_NARRATIVE=anthropic/claude-haiku-4.5

# Langfuse tracing. Recommended for prod — gives per-stage cost, token,
# latency and error dashboards. Free Hobby tier (50k events/mo, 30-day
# retention) covers ~1000 papers/mo at the current pipeline. See
# docs/cost_optimization.md for analysis. Get keys at https://cloud.langfuse.com.
# US region uses https://us.cloud.langfuse.com; EU uses https://cloud.langfuse.com.
# Leave blank to disable tracing — JSONL audit log in logs/ keeps working either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Versioning (optional; stamped into runs/<run_id>/manifest.json)
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1
