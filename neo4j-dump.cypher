UNWIND [{id:\"3e754c1d25f2a2e3537a6b6c\", properties:{p_value:0.154, predictors:\"Liver (acute organ dysfunction)\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Liver | 116 | (39.6) | 25 | (33.8) | 31 | (38.8) | 0.522 | 18 | (35.3) | 42 | (47.7) | 0.154\", verifier_verdict:\"ok\", timing:\"Within 24 hours after diagnosis\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:5, effect_type:\"other\", cohort_id:\"Cao 2021  Septic shock subgroup\", verifier_score:1.0, model_specification:\"Naive model, Comparison of survivors vs deaths (Fisher's exact test), Univariate analysis\", predictor_canonical:\"liver_organ_dysfunction\", outcome_type:\"mortality\", effect_size_str:\"Survival: 18 (35.3%) vs Death: 42 (47.7%), P=0.154\", anchor_section:\"Table 2\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"dd8a180e247226eaf9ac0931\", properties:{predictors:\"Lung infection\", p_value:0.017, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The mortality rates of patients with lung infection and abdomen infection in the septic shock group were both higher than those in the non-septic shock group (lung: 74.4% vs 57.5%, P=0.017; abdomen: 57.1% vs 36.6%, P=0.04)\", verifier_verdict:\"ok\", timing:\"At diagnosis\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Septic shock subgroup\", verifier_score:1.0, model_specification:\"Naive model, Comparison of mortality rate between non-septic shock and septic shock groups (Fisher's exact test), Univariate analysis\", predictor_canonical:\"lung_infection\", outcome_type:\"mortality\", effect_size_str:\"Septic shock mortality: 74.4% vs non-septic shock: 57.5%, P=0.017\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"6c97ce764853e22fb2a6ce27\", properties:{predictors:\"Abdomen infection\", p_value:0.04, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The mortality rates of patients with lung infection and abdomen infection in the septic shock group were both higher than those in the non-septic shock group (lung: 74.4% vs 57.5%, P=0.017; abdomen: 57.1% vs 36.6%, P=0.04)\", verifier_verdict:\"ok\", timing:\"At diagnosis\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Septic shock subgroup\", verifier_score:1.0, model_specification:\"Naive model, Comparison of mortality rate between non-septic shock and septic shock groups (Fisher's exact test), Univariate analysis\", predictor_canonical:\"abdomen_infection\", outcome_type:\"mortality\", effect_size_str:\"Septic shock mortality: 57.1% vs non-septic shock: 36.6%, P=0.04\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"3236edf6c1f21cf413bce914\", properties:{predictors:\"immunosuppression\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"A six-parameter model was found with odds ratios (OR) of more than one for age, immunosuppression, CRP and bilirubin and OR of less than one for GCS score and body temperature.\", verifier_verdict:\"ok\", timing:\"Before ICU admission\", is_significant:false, adjustment_kind:\"multivariate\", paper_file_name:\"Koozi_2023\", anchor_page:4, effect_value:1.0, effect_type:\"OR\", cohort_id:\"Koozi 2023  Total Cohort\", outcome_window_days:30, verifier_score:0.95, model_specification:\"Backward stepwise multivariate logistic regression (six-parameter model: age, immunosuppression, GCS, body temperature, CRP, bilirubin)\", predictor_canonical:\"immunosuppression\", outcome_type:\"mortality\", effect_size_str:\"OR > 1\", anchor_section:\"Multivariate logistic regression\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"30-day mortality\", anchor_bbox:\"null\"}}, {id:\"7c6255dd59777f2e8be86a03\", properties:{predictors:\"SOFA\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Множественный регрессионный анализ с включением трех независимых предикторов подтвердил значимость оценки по шкале SOFA (ОШ 1,4179; 95% ДИ 1,0374-1,9380; р = 0,029) и лактатемии (ОШ 2,7536; 95% ДИ 1,2859 -5,8965; р = 0,009). Оценка по APACHE II предикторную значимость потеряла (ОШ 1,006; 95% ДИ 0,8177 -1,2390; р = 0,951).\", is_significant:true, verifier_score:0.95, model_specification:\"Multivariate logistic regression adjusted for APACHE II, SOFA, lactate\", predictor_canonical:\"SOFA\", ci_lo:1.0374, anchor_section:\"Результаты исследования\", ci_hi:1.938, outcome:\"In-ICU mortality\", anchor_bbox:\"null\", p_value:0.029, verifier_verdict:\"ok\", timing:\"Within 24 hours of ICU admission\", adjustment_kind:\"multivariate\", paper_file_name:\"Kozlov_2022\", anchor_page:5, effect_value:1.4179, effect_type:\"OR\", cohort_id:\"Kozlov 2022  Total Cohort (Stage 1, n=134)\", outcome_type:\"mortality\", effect_size_str:\"OR 1,4179 (95% CI 1,0374-1,9380), p = 0,029\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"6549fa306658d87e4359128e\", properties:{predictors:\"Glasgow Coma Scale\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"A six-parameter model was found with odds ratios (OR) of more than one for age, immunosuppression, CRP and bilirubin and OR of less than one for GCS score and body temperature.\", verifier_verdict:\"ok\", timing:\"Worst recorded value 6h prior to 1h after ICU admission\", is_significant:false, adjustment_kind:\"multivariate\", paper_file_name:\"Koozi_2023\", effect_value:1.0, anchor_page:4, effect_type:\"OR\", cohort_id:\"Koozi 2023  Total Cohort\", outcome_window_days:30, verifier_score:0.95, model_specification:\"Backward stepwise multivariate logistic regression (six-parameter model: age, immunosuppression, GCS, body temperature, CRP, bilirubin)\", predictor_canonical:\"GCS\", outcome_type:\"mortality\", effect_size_str:\"OR < 1\", anchor_section:\"Multivariate logistic regression\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"30-day mortality\", anchor_bbox:\"null\"}}, {id:\"c3777f135bbd03c1aa02432f\", properties:{predictors:\"Лактатемия\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Множественный регрессионный анализ с включением трех независимых предикторов подтвердил значимость оценки по шкале SOFA (ОШ 1,4179; 95% ДИ 1,0374-1,9380; р = 0,029) и лактатемии (ОШ 2,7536; 95% ДИ 1,2859 -5,8965; р = 0,009). Оценка по APACHE II предикторную значимость потеряла (ОШ 1,006; 95% ДИ 0,8177 -1,2390; р = 0,951).\", is_significant:true, verifier_score:0.98, model_specification:\"Multivariate logistic regression adjusted for APACHE II, SOFA, lactate\", predictor_canonical:\"lactate\", ci_lo:1.2859, anchor_section:\"Результаты исследования\", ci_hi:5.8965, outcome:\"In-ICU mortality\", anchor_bbox:\"null\", p_value:0.009, verifier_verdict:\"ok\", timing:\"Within 24 hours of ICU admission\", adjustment_kind:\"multivariate\", paper_file_name:\"Kozlov_2022\", anchor_page:5, effect_value:2.7536, effect_type:\"OR\", cohort_id:\"Kozlov 2022  Total Cohort (Stage 1, n=134)\", outcome_type:\"mortality\", effect_size_str:\"OR 2,7536 (95% CI 1,2859-5,8965), p = 0,009\", prompt_id:\"predictor_extract_v1@618f1f75\"}}, {id:\"4bb270607bd9e6a18f2e2d73\", properties:{predictors:\"body temperature\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"A six-parameter model was found with odds ratios (OR) of more than one for age, immunosuppression, CRP and bilirubin and OR of less than one for GCS score and body temperature.\", verifier_verdict:\"ok\", timing:\"Worst recorded value 6h prior to 1h after ICU admission\", is_significant:false, adjustment_kind:\"multivariate\", paper_file_name:\"Koozi_2023\", effect_