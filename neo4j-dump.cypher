tment_kind:\"univariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"other\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of non-sepsis vs sepsis (Wilcoxon rank-sum), Univariate analysis\", predictor_canonical:\"hospital_LOS\", outcome_type:\"los\", effect_size_str:\"17.0 (10.0-25.0) vs 18.0 (10.0-29.0) days, p=0.002\", anchor_section:\"Table 1\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"Sepsis (vs non-sepsis)\", anchor_bbox:\"null\"}}, {id:\"2a724aa7812ab114aca8cb21\", properties:{predictors:\"Age\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"After adjusting for potential confounders, having no comorbid conditions and the use of antibiotics within 1 h of sepsis onset were associated with relatively lower ICU mortality in patients with sepsis. However, advanced age; high APACHE II score; comorbid cardiovascular diseases and tumors; infection with Acinetobacter, Pseudomonas, and Staphylococcus; and the use of RRT were independent risk factors for ICU mortality in patients with sepsis.\", verifier_verdict:\"partial\", timing:\"On admission to ICU\", is_significant:false, adjustment_kind:\"multivariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"OR\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:0.72, model_specification:\"Multivariable stepwise logistic regression (Table 7) adjusted for age, sex, APACHE II score, SOFA-initial score, comorbid conditions, use of MV, RRT and vasopressors, sites of infection, isolated organisms, use of antibiotics within 1h, use of antibiotics pre-sepsis, and septic shock\", predictor_canonical:\"age\", outcome_type:\"mortality\", effect_size_str:\"Independent risk factor for ICU mortality in patients with sepsis\", anchor_section:\"Factors Associated With Mortality in All Patients With Sepsis\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"80f6124101ca993ae166374a\", properties:{predictors:\"APACHE II score\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"After adjusting for potential confounders, having no comorbid conditions and the use of antibiotics within 1 h of sepsis onset were associated with relatively lower ICU mortality in patients with sepsis. However, advanced age; high APACHE II score; comorbid cardiovascular diseases and tumors; infection with Acinetobacter, Pseudomonas, and Staphylococcus; and the use of RRT were independent risk factors for ICU mortality in patients with sepsis.\", verifier_verdict:\"partial\", timing:\"Within 24 hours of ICU admission\", is_significant:false, adjustment_kind:\"multivariate\", paper_file_name:\"Wang_2020\", anchor_page:5, effect_type:\"OR\", cohort_id:\"Wang 2020 CCCST Total Cohort\", verifier_score:0.72, model_specification:\"Multivariable stepwise logistic regression (Table 7) adjusted for age, sex, APACHE II score, SOFA-initial score, comorbid conditions, use of MV, RRT and vasopressors, sites of infection, isolated organisms, use of antibiotics within 1h, use of antibiotics pre-sepsis, and septic shock\", predictor_canonical:\"APACHE_II\", outcome_type:\"mortality\", effect_size_str:\"Independent risk factor for ICU mortality in patients with sepsis\", anchor_section:\"Factors Associated With Mortality in All Patients With Sepsis\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"ICU mortality\", anchor_bbox:\"null\"}}, {id:\"e9688a98a2173a86c4f4288f\", properties:{predictors:\"Comorbid cardiovascular diseases\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"After adjusting for potential confounders, having no comorbid conditions and the use of antibiotics within 1 h of sepsis onset were associated with relatively lower ICU mortality in patients with sepsis. However, advanced age; high APACHE II score; comorbid cardiovascular diseases and tumors; infection with Acinetobacter, Pseudomonas, and Staphyl