---
// Phase 2 stub. API key form, persists to localStorage.
---
<dialog id="atlas-settings" class="settings">
  <form method="dialog">
    <h3 style="margin: 0 0 8px; color: var(--accent);">Settings</h3>
    <label for="atlas-key" style="color: var(--fg-muted); font-size: 12px;">
      OpenRouter API key (stored in your browser only)
    </label>
    <input
      id="atlas-key"
      name="key"
      type="password"
      autocomplete="off"
      placeholder="sk-or-..."
    />
    <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px;">
      <button value="cancel">Cancel</button>
      <button id="atlas-save-key" value="save">Save</button>
    </div>
  </form>
</dialog>
<script>
  const KEY = "atlas_openrouter_key";
  const dialog = document.getElementById("atlas-settings") as HTMLDialogElement | null;
  const input = document.getElementById("atlas-key") as HTMLInputElement | null;
  if (dialog && input) {
    input.value = localStorage.getItem(KEY) || "";
    dialog.addEventListener("close", () => {
      if (dialog.returnValue === "save") {
        const v = input.value.trim();
        if (v) localStorage.setItem(KEY, v);
        else localStorage.removeItem(KEY);
      }
    });
  }
  // Expose opener so a future settings button can call it.
  (window as any).atlasOpenSettings = () => dialog?.showModal();
</script>
