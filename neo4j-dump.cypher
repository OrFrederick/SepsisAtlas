UNWIND [{id:\"a56328d95b36a840f7151392\", properties:{predictors:\"Sepsis diagnosis (Sepsis-3 criteria)\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"A total of 2018 patients were admitted to the 7 ICUs. The characteristics of the ICUs are shown in Table 1 . After excluding 52 re-transfers and 362 patients who did not meet the eligibility criteria, 1604 patients were screened for sepsis, of which 294 were diagnosed with sepsis. Thus, the prevalence of sepsis in ICU patients was 18.3% (294/1604), and 140/294 (47.6%) of these sepsis patients had septic shock.\", verifier_verdict:\"ok\", timing:\"During ICU admission (October 10, 2017 to January 9, 2018)\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", effect_value:0.183, anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Screened cohort\", verifier_score:0.98, model_specification:\"Naive model, Comparison of screened patients, Univariate analysis\", predictor_canonical:\"sepsis_prevalence\", outcome_type:\"other\", effect_size_str:\"294/1604 (18.3%)\", anchor_section:\"Participants\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"Sepsis prevalence\", anchor_bbox:\"null\"}}, {id:\"0fcbd4c2ea2dd236c68872d7\", properties:{predictors:\"Septic shock\", extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"A total of 2018 patients were admitted to the 7 ICUs. The characteristics of the ICUs are shown in Table 1 . After excluding 52 re-transfers and 362 patients who did not meet the eligibility criteria, 1604 patients were screened for sepsis, of which 294 were diagnosed with sepsis. Thus, the prevalence of sepsis in ICU patients was 18.3% (294/1604), and 140/294 (47.6%) of these sepsis patients had septic shock.\", verifier_verdict:\"ok\", timing:\"During ICU admission\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", effect_value:0.476, anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Screened cohort\", verifier_score:0.98, model_specification:\"Naive model, Comparison of screened patients, Univariate analysis\", predictor_canonical:\"septic_shock_prevalence\", outcome_type:\"other\", effect_size_str:\"140/294 (47.6%)\", anchor_section:\"Participants\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"Septic shock prevalence among sepsis patients\", anchor_bbox:\"null\"}}, {id:\"2d924b934fbc93db7f194e10\", properties:{predictors:\"Age (months)\", p_value:0.902, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Age (months) | 24 (2-144) | 21 (1-144) | 24 (1-144) | 0.902\", verifier_verdict:\"ok\", timing:\"Within 24 hours of admission\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Baloch_2022\", anchor_page:3, effect_type:\"other\", cohort_id:\"Baloch 2022  Total Cohort\", outcome_window_days:30, verifier_score:0.95, model_specification:\"Naive model, Comparison of non-survivors vs survivors (Mann-Whitney), Univariate analysis\", predictor_canonical:\"age\", outcome_type:\"mortality\", effect_size_str:\"Non-survivors: 24 (2-144) vs Survivors: 21 (1-144), p=0.902\", anchor_section:\"TABLE 1: Baseline information of study sample (n=286)\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"30-day mortality\", anchor_bbox:\"null\"}}, {id:\"ef7213efd4a6a2958b2e69ee\", properties:{predictors:\"Weight (kg)\", p_value:0.578, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"Weight (kg) | 10 (2.2-40) | 10 (2.7-47) | 10 (2.2-47) | 0.578\", verifier_verdict:\"partial\", timing:\"Within 24 hours of admission\", is_significant:false, adjustment_kind:\"univariate\", paper_file_name:\"Baloch_2022\", anchor_page:3, effect_type:\"other\", cohort_id:\"Baloch 2022  Total Cohort\", outcome_window_days:30, verifier_score:0.75, model_specification:\"Naive model, Comparison of non-survivors vs survivors (Mann-Whitney), Univariate analysis\", predictor_canonical:\"weight\", outcome_type:\"mortality\", effect_size_