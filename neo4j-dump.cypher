any\", properties:{canonical:\"sepsis vs non-sepsis group comparison\", type:\"los\"}}, {outcome_id:\"in-hospital mortality::other::any\", properties:{canonical:\"in-hospital mortality\", type:\"other\"}}, {outcome_id:\"sepsis vs non-sepsis (group comparison)::other::any\", properties:{canonical:\"sepsis vs non-sepsis (group comparison)\", type:\"other\"}}, {outcome_id:\"sepsis vs non-sepsis (group comparison)::los::any\", properties:{canonical:\"sepsis vs non-sepsis (group comparison)\", type:\"los\"}}, {outcome_id:\"community-acquired vs hospital-acquired sepsis comparison::other::any\", properties:{canonical:\"community-acquired vs hospital-acquired sepsis comparison\", type:\"other\"}}, {outcome_id:\"hospital-acquired vs community-acquired sepsis::other::any\", properties:{canonical:\"hospital-acquired vs community-acquired sepsis\", type:\"other\"}}] AS row
