:begin
CREATE RANGE INDEX FOR (n:Cohort) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:Figure) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:Outcome) ON (n.canonical);
CREATE RANGE INDEX FOR (n:Outcome) ON (n.type);
CREATE RANGE INDEX FOR (n:PaperTable) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:PhenotypeCluster) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:PredictorModel) ON (n.outcome_type);
CREATE RANGE INDEX FOR (n:PredictorModel) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:PredictorModel) ON (n.predictor_canonical);
CREATE RANGE INDEX FOR (n:Reference) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:Section) ON (n.paper_file_name);
CREATE RANGE INDEX FOR (n:StatMethod) ON (n.family);
CREATE CONSTRAINT cohort_id FOR (node:Cohort) REQUIRE (node.cohort_id) IS UNIQUE;
CREATE CONSTRAINT figure_id FOR (node:Figure) REQUIRE (node.figure_id) IS UNIQUE;
CREATE CONSTRAINT outcome_id FOR (node:Outcome) REQUIRE (node.outcome_id) IS UNIQUE;
CREATE CONSTRAINT paper_file_name FOR (node:Paper) REQUIRE (node.file_name) IS UNIQUE;
CREATE CONSTRAINT phenotypecluster_id FOR (node:PhenotypeCluster) REQUIRE (node.cluster_id) IS UNIQUE;
CREATE CONSTRAINT pm_id FOR (node:PredictorModel) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT predictor_canonical FOR (node:Predictor) REQUIRE (node.canonical) IS UNIQUE;
CREATE CONSTRAINT ref_id FOR (node:Reference) REQUIRE (node.ref_id) IS UNIQUE;
CREATE CONSTRAINT section_id FOR (node:Section) REQUIRE (node.section_id) IS UNIQUE;
CREATE CONSTRAINT setting_type FOR (node:Setting) REQUIRE (node.type) IS UNIQUE;
CREATE CONSTRAINT statmethod_name FOR (node:StatMethod) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT table_id FOR (node:PaperTable) REQUIRE (node.table_id) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
