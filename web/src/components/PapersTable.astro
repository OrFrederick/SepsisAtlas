---
import type { Paper } from "../lib/types";

interface Props {
  papers: Paper[];
}
const { papers } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";
---
<table class="papers" id="papers-table">
  <thead>
    <tr>
      <th data-key="file_name" data-type="str">File</th>
      <th data-key="title" data-type="str">Title</th>
      <th data-key="year" data-type="num">Year</th>
      <th data-key="n_rows" data-type="num">Rows</th>
      <th data-key="ok" data-type="num">✓ ok</th>
      <th data-key="weak" data-type="num">~ weak</th>
      <th data-key="fail" data-type="num">✗ fail</th>
      <th data-key="parsed" data-type="bool">Parsed</th>
      <th data-key="translated" data-type="bool">Translated</th>
      <th data-key="last_update" data-type="str" class="sort-desc">Last update</th>
    </tr>
  </thead>
  <tbody>
    {papers.map((p) => {
      const href = `${b}papers/${encodeURIComponent(p.file_name)}/`;
      return (
        <tr data-href={href}>
          <td>{p.file_name}</td>
          <td>{p.title || ""}</td>
          <td>{p.year ?? ""}</td>
          <td>{p.n_rows}</td>
          <td class="col-ok">{p.verdicts?.ok ?? 0}</td>
          <td class="col-weak">{p.verdicts?.weak ?? 0}</td>
          <td class="col-fail">{p.verdicts?.fail ?? 0}</td>
          <td class={`col-flag ${p.parsed ? "yes" : "no"}`}>{p.parsed ? "yes" : "no"}</td>
          <td class={`col-flag ${p.translated ? "yes" : "no"}`}>{p.translated ? "yes" : "no"}</td>
          <td>{p.last_update || ""}</td>
        </tr>
      );
    })}
  </tbody>
</table>
<script>
  const table = document.getElementById("papers-table") as HTMLTableElement | null;
  if (table) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);

    table.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const tr = target.closest("tr");
      if (tr && tr.parentElement === tbody) {
        const href = tr.dataset.href;
        if (href) location.href = href;
      }
    });

    const headers = Array.from(table.tHead!.rows[0].cells);
    let activeKey: string | null = "last_update";
    let activeDir: 1 | -1 = -1;

    function sortBy(key: string, type: string, dir: 1 | -1) {
      const idx = headers.findIndex((h) => h.dataset.key === key);
      const sorted = [...rows].sort((a, b) => {
        let av: any = a.cells[idx]?.textContent?.trim() ?? "";
        let bv: any = b.cells[idx]?.textContent?.trim() ?? "";
        if (type === "num") {
          av = parseFloat(av) || 0;
          bv = parseFloat(bv) || 0;
        } else if (type === "bool") {
          av = av === "yes" ? 1 : 0;
          bv = bv === "yes" ? 1 : 0;
        }
        if (av < bv) return -1 * dir;
        if (av > bv) return 1 * dir;
        return 0;
      });
      tbody.replaceChildren(...sorted);
    }

    headers.forEach((h) => {
      h.addEventListener("click", () => {
        const key = h.dataset.key!;
        const type = h.dataset.type || "str";
        if (activeKey === key) {
          activeDir = (activeDir === 1 ? -1 : 1) as 1 | -1;
        } else {
          activeKey = key;
          activeDir = 1;
        }
        headers.forEach((x) => x.classList.remove("sort-asc", "sort-desc"));
        h.classList.add(activeDir === 1 ? "sort-asc" : "sort-desc");
        sortBy(key, type, activeDir);
      });
    });
  }
</script>
