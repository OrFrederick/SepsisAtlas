---
import Base from "../../layouts/Base.astro";
import SplitShell from "../../components/SplitShell.astro";
import ResultCard from "../../components/ResultCard.astro";
import type { Paper, Row } from "../../lib/types";
import { buildViewerUrl } from "../../lib/viewerUrl";
import papersJson from "../../../public/data/papers.json";
import rowsJson from "../../../public/data/rows.json";

export async function getStaticPaths() {
  const papers = papersJson as Paper[];
  const rows = rowsJson as Row[];
  return papers.map((p) => {
    // Filter rows.json down to rows for THIS paper at build time so each
    // route ships only the evidence relevant to its paper.
    const paperRows = rows.filter((r) => r.file_name === p.file_name);
    return { params: { stem: p.file_name }, props: { paper: p, rows: paperRows } };
  });
}

interface Props {
  paper: Paper;
  rows: Row[];
}
const { paper, rows } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : base + "/";

// Default right-pane URL: first row's anchor, or page 1 if no rows.
const firstRow = rows[0];
const defaultViewerUrl = firstRow
  ? buildViewerUrl(b, paper.file_name, firstRow.anchor_page ?? 1, firstRow.anchor_bbox, "tl")
  : buildViewerUrl(b, paper.file_name, 1);

const subtitle = [paper.year, paper.journal].filter(Boolean).join(" · ");
---
<Base title={`Sepsis Atlas — ${paper.file_name}`} route="papers">
  <SplitShell>
    <nav class="paper-breadcrumb">
      <a href={`${b}papers/`}>← Papers</a>
    </nav>
    <header class="paper-header">
      {/* paper.title is rendered as a text expression — Astro escapes it. */}
      <h1>{paper.title || paper.file_name}</h1>
      {subtitle && <p class="paper-meta">{subtitle}</p>}
      <p class="paper-counts">
        <strong>{rows.length}</strong> evidence row{rows.length === 1 ? "" : "s"}
        {paper.verdicts && (
          <>
            {" · "}
            <span class="badge ok">ok {paper.verdicts.ok ?? 0}</span>{" "}
            <span class="badge warn">weak {paper.verdicts.weak ?? 0}</span>{" "}
            <span class="badge fail">fail {paper.verdicts.fail ?? 0}</span>
          </>
        )}
      </p>
    </header>
    <div class="paper-rows">
      {rows.length === 0 ? (
        <p style="color: var(--fg-muted);">No extracted rows for this paper.</p>
      ) : (
        rows.map((r) => <ResultCard row={r} />)
      )}
    </div>
  </SplitShell>
  <style>
    .paper-breadcrumb { margin-bottom: 8px; font-size: 12px; }
    .paper-header { margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
    .paper-header h1 { margin: 0 0 4px; font-size: 16px; color: var(--fg); }
    .paper-meta { margin: 2px 0; color: var(--fg-muted); font-size: 12px; }
    .paper-counts { margin: 6px 0 0; color: var(--fg-muted); font-size: 12px; }
    .paper-rows { display: flex; flex-direction: column; gap: 10px; }
  </style>
  {/*
    Inline (non-module) script runs before the deferred SplitShell module,
    so setting __ATLAS_DEFAULT_URL__ here means the per-paper default wins
    over the cross-page localStorage value when SplitShell initializes.
    A late event dispatch is included as a fallback.
  */}
  <script is:inline define:vars={{ defaultUrl: defaultViewerUrl }}>
    window.__ATLAS_DEFAULT_URL__ = defaultUrl;
  </script>
  <script define:vars={{ defaultUrl: defaultViewerUrl }}>
    document.dispatchEvent(
      new CustomEvent("atlas:viewer-default", { detail: { href: defaultUrl } }),
    );
  </script>
</Base>
