---
import Base from "../../layouts/Base.astro";
import PdfViewer from "../../components/PdfViewer.astro";
import type { Paper } from "../../lib/types";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

export async function getStaticPaths() {
  const here = dirname(fileURLToPath(import.meta.url));
  const dataPath = join(here, "..", "..", "..", "public", "data", "papers.json");
  let papers: Paper[] = [];
  try {
    papers = JSON.parse(readFileSync(dataPath, "utf-8")) as Paper[];
  } catch {
    papers = [];
  }
  return papers.map((p) => ({ params: { stem: p.file_name } }));
}

const { stem } = Astro.params;
---
<Base title={`Sepsis Atlas — ${stem}`} route="viewer">
  <PdfViewer stem={stem!} />
</Base>
