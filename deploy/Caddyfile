# Sepsis Atlas — main site + path-based per-PR previews
#
# Layout:
#   atlas.efferon.com            → static Astro build at /var/www/atlas-main,
#                                   API paths reverse-proxied to 127.0.0.1:8000
#   atlas.efferon.com/pr/<N>/    → static Astro build at /var/www/atlas-pr-<N>
#   atlas.efferon.com/pr/<N>/api → reverse-proxied to PR-N's backend on 127.0.0.1:(8100+N%800)
#
# PR previews are path-prefixed so a single TLS cert covers them — no wildcard
# DNS required. Each PR drops a snippet into /etc/caddy/Caddyfile.d/pr-routes/
# which is imported inside the main site block, declaring two handle_path
# directives. handle_path strips the prefix before the inner handler runs, so
# the backend and static files see root-relative paths.

{
	email ops@efferon.com
}

atlas.efferon.com {
	encode zstd gzip

	# PR previews land here as handle_path blocks. handle_path is more
	# specific than the catch-all main handle below, so it wins for any
	# request beginning with /pr/<N>/.
	import /etc/caddy/Caddyfile.d/pr-routes/*.caddy

	# Main API surface — keep paths in sync with src/api/main.py.
	@api path /query* /viewer/* /papers/* /static/* /health* /phenotypes* /rank_predictors* /ingest_pubmed /query_kg* /kg*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# Main static SPA fallback.
	handle {
		root * /var/www/atlas-main
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/atlas.efferon.com.access.log
	}
}
