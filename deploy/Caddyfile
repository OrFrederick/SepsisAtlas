# Sepsis Atlas — atlas.efferon.com
#
# Single site:
#   /             → static Astro build at /var/www/atlas-main
#   /query, /viewer/*, /papers/*, /static/*, /health*, /phenotypes,
#   /rank_predictors, /ingest_pubmed, /query_kg*, /kg*
#                 → reverse-proxied to FastAPI at 127.0.0.1:8000

{
	email ops@efferon.com
}

atlas.efferon.com {
	encode zstd gzip
	root * /var/www/atlas-main

	# API surface — keep in sync with src/api/main.py.
	@api path /query* /viewer/* /papers/* /static/* /health* /phenotypes* /rank_predictors* /ingest_pubmed /query_kg* /kg*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# Static SPA fallback for everything else.
	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/atlas.efferon.com.access.log
	}
}
