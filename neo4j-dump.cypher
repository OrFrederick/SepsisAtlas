UNWIND [{cohort_id:\"Kochkin 2021  Total Cohort\", properties:{predictors_canonical:[\"multivariable_model\", \"SOFA\", \"norepinephrine_dose\", \"PF_ratio\", \"procalcitonin\", \"sex\", \"lactate\", \"RRT\", \"age\", \"additional_vasopressors\", \"diabetes\"], mortality_timepoint:\"28-day mortality\", population_description:\"Patients with refractory septic shock (norepinephrine dose ≥0.5 mcg/kg/min to maintain MAP >65 mmHg), aged 42–74 years, SOFA score 8–16, on mechanical ventilation ≤24 hours at enrollment, within 24 hours of septic shock onset; excluding oncological disease, pregnancy, hemodynamically significant cardiac defects, massive surgical bleeding, recurrent septic shock during hospitalization\", cohort_size_n:\"79\", cohort_label:\"Total Cohort\", paper_file_name:\"Kochkin_2021\", mortality_rate_pct:44.0, n_predictor_models:18}}, {cohort_id:\"Kozlov 2022  Total Cohort (Stage 1, n=134)\", properties:{predictors_canonical:[\"multivariable_model\", \"lactate\", \"SOFA\", \"APACHE_II\", \"NT_proBNP\", \"PCT\", \"pH\", \"sO2v\", \"vasoactive_inotropic_index\", \"inotropic_index\", \"heart_rate\", \"MAP\", \"sex\"], mortality_timepoint:\"In-ICU\", population_description:\"Patients aged 18–85 years with abdominal sepsis or septic shock according to Sepsis-3 criteria, admitted to ICU from 01.06.2019 to 01.06.2020; excluding death in first hours before laboratory tests, terminal stage of oncological disease, concomitant valvular heart disease or chronic heart failure, pregnancy\", cohort_size_n:\"134\", cohort_label:\"Total Cohort\", paper_file_name:\"Kozlov_2022\", mortality_rate_pct:47.0, n_predictor_models:29}}, {cohort_id:\"Kozlov 2022  Invasive Hemodynamic Monitoring Subcohort (Stage 2, n=52)\", properties:{predictors_canonical:[\"multivariable_model\", \"cardiac_function_index\", \"cardiac_index\"], mortality_timepoint:\"In-ICU\", population_description:\"Subset of the 134-patient cohort in whom invasive monitoring of central hemodynamics with transpulmonary thermodilution was established 24–72 hours after ICU admission based on clinical indications\", cohort_size_n:\"52\", cohort_label:\"Invasive Hemodynamic Monitoring Subcohort\", paper_file_name:\"Kozlov_2022\", mortality_rate_pct:30.7, n_predictor_models:4}}, {cohort_id:\"Kozlov 2022  Risk Factors Present Subgroup (n=14)\", properties:{predictors_canonical:[\"SOFA_lactate_combination\"], population_description:\"Subset of the 52-patient invasive monitoring cohort with combination of established mortality risk factors (SOFA >8 points and lactatemia >1.8 mmol/l)\", cohort_size_n:\"14\", cohort_label:\"Risk Factors Present Subgroup\", paper_file_name:\"Kozlov_2022\", n_predictor_models:4}}, {cohort_id:\"Kozlov 2022  Risk Factors Absent Subgroup (n=38)\", properties:{predictors_canonical:[], population_description:\"Subset of the 52-patient invasive monitoring cohort without combination of established mortality risk factors (SOFA >8 points and lactatemia >1.8 mmol/l)\", cohort_size_n:\"38\", cohort_label:\"Risk Factors Absent Subgroup\", paper_file_name:\"Kozlov_2022\", n_predictor_models:0}}, {cohort_id:\"Park 2022  ICU sepsis due to IAI cohort\", properties:{predictors_canonical:[\"cardiovascular_dysfunction\", \"multivariable_model\", \"MDR\", \"number_organ_dysfunction\", \"source_control_time\", \"source_control\", \"time_to_antibiotics\", \"bacteremia\", \"CRRT\", \"SAPS_3\", \"SOFA\", \"lactate\", \"septic_shock\", \"CCI\", \"BMI\", \"age\", \"renal_dysfunction\", \"CNS_dysfunction\", \"liver_dysfunction\", \"coagulation_dysfunction\", \"respiratory_dysfunction\", \"BNP\", \"procalcitonin\", \"CRP\", \"bilirubin\", \"creatinine\", \"platelet_count\", \"steroid_use\", \"ECOG\", \"sex\", \"total_bilirubin\"], mortality_timepoint:\"28-day mortality\", population_description:\"Patients aged >19 years admitted to intensive care units owing to sepsis caused by intra-abdominal infection (IAI), enrolled from 16 tertiary care hospitals in Korea over 6 months\", cohort