---
import Base from "../layouts/Base.astro";
import PapersTable from "../components/PapersTable.astro";
import type { Paper } from "../lib/types";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const __dirname = dirname(fileURLToPath(import.meta.url));
const dataPath = join(__dirname, "..", "..", "public", "data", "papers.json");

let papers: Paper[] = [];
try {
  papers = JSON.parse(readFileSync(dataPath, "utf-8")) as Paper[];
} catch {
  papers = [];
}

papers.sort((a, b) => (b.last_update || "").localeCompare(a.last_update || ""));
---
<Base title="Sepsis Atlas — Papers" route="papers">
  <h1 style="margin: 0 0 12px; font-size: 18px;">Corpus ({papers.length} papers)</h1>
  {papers.length === 0 ? (
    <p style="color: var(--fg-muted);">No papers exported yet. Run <code>scripts/export_static.py</code> to populate <code>public/data/papers.json</code>.</p>
  ) : (
    <PapersTable papers={papers} />
  )}
</Base>
