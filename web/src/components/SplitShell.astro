---
/**
 * Split layout shell: fixed-width left pane (composer / row list) + 1px
 * divider + flex-1 right pane (persistent PDF iframe).
 *
 * Both `index.astro` (chat search) and `papers/[stem].astro` (per-paper
 * drill-down) embed this component and fill the left pane via the default
 * slot. The right pane is owned here so click handlers and localStorage
 * logic stay in one place.
 *
 * Click delegation: any element carrying `data-viewer-href` (cards on the
 * left pane) updates `iframe.src` and is marked `.active`. The card markup
 * itself lives in `ResultCard.astro` (server-rendered) and `cardTemplate.ts`
 * (client-rendered) — both must emit `data-viewer-href`.
 *
 * Per-page default URL: a page may set `window.__ATLAS_DEFAULT_URL__`
 * before this script runs (via an `is:inline` script) to seed the iframe
 * with a paper-specific viewer URL on first load. That wins over the
 * cross-page localStorage value.
 */
---
<style is:global>
  /* Split-shell pages need to escape the narrow main container styled by
     the global stylesheet. Marked global so the rule reaches <main> in
     Base.astro, which lives outside this component's scoped CSS boundary. */
  body:has(.split-shell) main {
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>
<style>
  .split-shell {
    display: grid;
    grid-template-columns: 480px 1px 1fr;
    height: calc(100vh - 40px);
    width: 100%;
  }
  .split-left {
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 16px 60px;
    background: var(--bg);
  }
  .split-divider {
    background: var(--border);
    height: 100%;
  }
  .split-right {
    position: relative;
    background: var(--panel-2);
    overflow: hidden;
  }
  #atlas-viewer {
    width: 100%;
    height: 100%;
    border: 0;
    display: none;
    background: var(--panel-2);
  }
  #atlas-viewer-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    font-size: 13px;
    padding: 18px;
    text-align: center;
  }
  /* Active card highlight (applies to any descendant of split-shell). */
  :global([data-viewer-href].active) {
    border-color: var(--border-strong) !important;
    box-shadow: 0 0 0 1px var(--border-strong);
  }
  @media (max-width: 900px) {
    .split-shell {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1px 60vh;
      height: auto;
    }
    .split-divider {
      height: 1px;
      width: 100%;
    }
  }
</style>

<div class="split-shell">
  <section class="split-left">
    <slot />
  </section>
  <div class="split-divider"></div>
  <section class="split-right">
    <iframe id="atlas-viewer" title="PDF viewer"></iframe>
    <div id="atlas-viewer-empty">
      Click an evidence row to view the source PDF.
    </div>
  </section>
</div>

<script>
  const iframe = document.getElementById("atlas-viewer") as HTMLIFrameElement | null;
  const empty = document.getElementById("atlas-viewer-empty") as HTMLElement | null;
  if (iframe && empty) {
    // Parses `/viewer/<stem>?page=N&bbox=...&origin=...` into its parts.
    // Returns null if the href is malformed so callers fall back to a full
    // iframe reload.
    function parseViewerHref(href: string): {
      stem: string;
      page: number;
      bbox: number[] | null;
      origin: string;
    } | null {
      try {
        const u = new URL(href, window.location.origin);
        const m = u.pathname.match(/\/viewer\/([^/]+)\/?$/);
        if (!m) return null;
        const stem = decodeURIComponent(m[1]);
        const page = Math.max(1, parseInt(u.searchParams.get("page") || "1", 10));
        const bboxStr = u.searchParams.get("bbox");
        const bboxParts = bboxStr ? bboxStr.split(",").map(Number) : null;
        const bbox = bboxParts && bboxParts.length === 4 && bboxParts.every(Number.isFinite)
          ? bboxParts
          : null;
        const origin = (u.searchParams.get("origin") || "tl").toLowerCase();
        return { stem, page, bbox, origin };
      } catch {
        return null;
      }
    }

    // Tracks the stem currently loaded in the iframe so we can decide between
    // a full reload (different paper) and an in-iframe postMessage (same paper).
    let currentStem: string | null = null;

    function show(href: string) {
      const parsed = parseViewerHref(href);
      if (parsed && currentStem === parsed.stem && iframe!.contentWindow) {
        // Target the iframe's same-origin viewer page explicitly. The viewer
        // is always served by the Astro app at this origin, so anything else
        // is either a misconfiguration or an attempt to spoof — drop it.
        iframe!.contentWindow.postMessage(
          {
            type: "sepsis-atlas:jump",
            page: parsed.page,
            bbox: parsed.bbox,
            origin: parsed.origin,
          },
          window.location.origin,
        );
        return;
      }
      iframe!.src = href;
      iframe!.style.display = "block";
      empty!.style.display = "none";
      currentStem = parsed?.stem ?? null;
    }

    // Per-page default (from window var) wins over cross-page localStorage.
    let restored = false;
    const pageDefault = (window as unknown as { __ATLAS_DEFAULT_URL__?: string })
      .__ATLAS_DEFAULT_URL__;
    if (pageDefault) {
      show(pageDefault);
      restored = true;
    } else {
      try {
        const last = localStorage.getItem("sepsis_atlas.last_viewer_url.v1");
        if (last) {
          show(last);
          restored = true;
        }
      } catch (_) {
        // ignore quota/permission errors
      }
    }

    // Late-arriving default (event-driven fallback).
    document.addEventListener("atlas:viewer-default", (e: Event) => {
      const ce = e as CustomEvent<{ href: string }>;
      const href = ce.detail?.href;
      if (!href || restored) return;
      show(href);
      restored = true;
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const card = target.closest("[data-viewer-href]") as HTMLElement | null;
      if (!card) return;
      e.preventDefault();
      const href = card.getAttribute("data-viewer-href");
      if (!href) return;
      show(href);
      try {
        localStorage.setItem("sepsis_atlas.last_viewer_url.v1", href);
      } catch (_) {
        // ignore quota/permission errors
      }
      document
        .querySelectorAll("[data-viewer-href].active")
        .forEach((el) => el.classList.remove("active"));
      card.classList.add("active");
    });
  }
</script>
