:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The APACHE-II score within 24 h after diagnosis of sepsis was higher in the death group than in the survival group (29 [IQR, 24-36] vs 23 [IQR, 17.5-26], P<0.001).\", verifier_verdict:\"ok\", timing:\"Within 24 hours after diagnosis of sepsis\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Sepsis cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of survivors vs deaths (rank-sum test), Univariate analysis\", predictor_canonical:\"APACHE_II\", outcome_type:\"mortality\", effect_size_str:\"Death: 29 (IQR, 24-36) vs Survival: 23 (IQR, 17.5-26), P<0.001\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"bdfe53fac5bf0f613d01e718\", properties:{predictors:\"SOFA score\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The SOFA score was higher in the death group than in the survival group (11 [IQR, 8-14] vs 8 [IQR, 6-10], P<0.001).\", verifier_verdict:\"ok\", timing:\"Within 24 hours after diagnosis of sepsis\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Sepsis cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of survivors vs deaths (rank-sum test), Univariate analysis\", predictor_canonical:\"SOFA\", outcome_type:\"mortality\", effect_size_str:\"Death: 11 (IQR, 8-14) vs Survival: 8 (IQR, 6-10), P<0.001\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"62d70f60769a0143d92d098a\", properties:{predictors:\"Mechanical ventilation time\", p_value:0.049, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"The mechanical ventilation time after diagnosis of sepsis (including invasive and non-invasive) was longer in the death group than in the survival group (55 [IQR, 17-140] vs 37 [IQR, 0-116], P=0.049).\", verifier_verdict:\"ok\", timing:\"After diagnosis of sepsis (including invasive and non-invasive)\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Sepsis cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of survivors vs deaths (rank-sum test), Univariate analysis\", predictor_canonical:\"mechanical_ventilation_time\", outcome_type:\"mortality\", effect_size_str:\"Death: 55 (IQR, 17-140) vs Survival: 37 (IQR, 0-116), P=0.049\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}, {id:\"8baca64870898bf7cf70480c\", properties:{predictors:\"ICU hospitalization time\", p_value:0.001, extractor_model:\"anthropic/claude-sonnet-4.6\", anchor_text:\"ICU hospitalization and total hospitalization time were shorter in the death group than in the survival group (4.00 [IQR, 2-8] vs 6 [IQR, 4-10], P<0.001)\", verifier_verdict:\"ok\", timing:\"During ICU stay\", is_significant:true, adjustment_kind:\"univariate\", paper_file_name:\"Cao_2021\", anchor_page:3, effect_type:\"other\", cohort_id:\"Cao 2021  Sepsis cohort\", verifier_score:1.0, model_specification:\"Naive model, Comparison of survivors vs deaths (rank-sum test), Univariate analysis\", predictor_canonical:\"icu_los\", outcome_type:\"mortality\", effect_size_str:\"Death: 4.00 (IQR, 2-8) vs Survival: 6 (IQR, 4-10), P<0.001\", anchor_section:\"Characteristics of the Patients\", prompt_id:\"predictor_extract_v1@618f1f75\", outcome:\"In-hospital mortality\", anchor_bbox:\"null\"}}] AS row
