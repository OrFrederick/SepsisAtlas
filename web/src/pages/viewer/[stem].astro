---
// Delegate to the backend viewer endpoint which serves static/viewer.html
// with CDN-based PDF.js. The Astro-generated viewer pages use local pdfjs
// paths that don't work in production.
export async function getStaticPaths() {
  return [];
}
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="0; url=/viewer/{Astro.params.stem}{Astro.url.search}">
</head>
<body>
  <p>Redirecting to PDF viewer…</p>
</body>
</html>
